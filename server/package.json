{
  "name": "@nakshatra/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check:db": "node scripts/check-database.mjs",
    "check:db-write": "node scripts/check-database-write.mjs",
    "init:db": "npm run build && node scripts/initialize-database.mjs",
    "seed:tarot": "tsx src/seeds/tarot.ts"
  },
  "dependencies": {
    "@types/luxon": "^3.7.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "resend": "^4.1.2",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "sweph": "^2.10.3-8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.17.0",
    "mongodb-memory-server": "^11.4.0",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
