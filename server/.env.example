NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=astro_galexa
# Optional: comma-separated trusted DNS server IPs for Node's DNS lookups.
MONGODB_DNS_SERVERS=
# Optional: Redis / Upstash TLS URL (e.g. rediss://default:password@host.upstash.io:6379) for caching, rate limiting & Socket.IO scaling
REDIS_URL=
# Optional (Recommended on Render Free Tier): secret token sent via x-cron-secret header to POST /api/v1/cron/daily-push
CRON_SECRET=
JWT_SECRET=replace-with-a-32-character-minimum-secret
OTP_HMAC_SECRET=replace-with-a-32-character-minimum-secret
OTP_LOG_CODES=true
RESEND_API_KEY=
EMAIL_FROM=Astro Galaxa <auth@example.com>
LEGAL_SUPPORT_EMAIL=support@astrogalaxa.com
GOOGLE_CLIENT_IDS=
FIREBASE_SERVICE_ACCOUNT_BASE64=
EXPO_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:8081
GEMINI_API_KEY=
# Free AI alternative: Get a 100% free key with no credit card at https://console.groq.com
GROQ_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
TRUST_PROXY=1
